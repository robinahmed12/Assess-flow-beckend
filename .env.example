# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=1d

# Frontend (used for callback redirects and signed links)
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects the browser after checkout.
# MUST point at the frontend in every environment.
STRIPE_SUCCESS_URL=http://localhost:3000/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/payments/cancel

# bKash (tokenized checkout)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# bKash redirects the buyer's browser here after paying.
# MUST point at the deployed backend in every environment.
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/bkash-payments/bkash/callback

# Email (payment invoices)
SMTP_USER=
SMTP_PASS=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_USER=
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
